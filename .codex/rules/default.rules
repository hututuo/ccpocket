# ccpocket project rules for Codex.
# Mirror the intent of .claude/settings.json, but keep auto-allow narrow.

# Safe local inspection.
prefix_rule(
    pattern=["ls"],
    justification="Listing files is read-only and low risk.",
)
prefix_rule(
    pattern=["pwd"],
    justification="Printing the working directory is read-only and low risk.",
)
prefix_rule(
    pattern=["which"],
    justification="Resolving executables is read-only and low risk.",
)
prefix_rule(
    pattern=[["rg", "grep"]],
    justification="Repository search is read-only.",
)
prefix_rule(
    pattern=[["cat", "sed", "head", "tail", "wc", "find", "tree"]],
    justification="File inspection commands are read-only.",
)
prefix_rule(
    pattern=[["ps", "pgrep", "lsof"]],
    justification="Process inspection is read-only.",
)

# Safe git inspection.
prefix_rule(
    pattern=["git", ["status", "diff", "show", "log", "branch", "rev-parse"]],
    justification="Read-only git inspection is safe to auto-allow.",
)

# Safe GitHub inspection.
prefix_rule(
    pattern=["gh", "issue", "view"],
    justification="Viewing issue details is read-only on GitHub.",
)
prefix_rule(
    pattern=["gh", "run", "view"],
    justification="Viewing CI run details is read-only on GitHub.",
)
prefix_rule(
    pattern=["gh", "search"],
    justification="GitHub search is read-only.",
)
prefix_rule(
    pattern=["gh", "pr", ["view", "diff", "checks"]],
    justification="PR inspection is read-only on GitHub.",
)

# Safe verification commands used in this repo.
prefix_rule(
    pattern=["npm", "run", "bridge:build"],
    decision="allow",
    justification="The repository Bridge build is a routine local verification step.",
)
prefix_rule(
    pattern=["npm", "run", "test:bridge"],
    decision="allow",
    justification="The repository Bridge test script is a routine local verification step.",
)
prefix_rule(
    pattern=["npm", "test", "--workspace=packages/bridge"],
    decision="allow",
    justification="The scoped Bridge test runner is a routine local verification step.",
)
prefix_rule(
    pattern=["npm", "run", ["functions:typecheck", "functions:build"]],
    decision="allow",
    justification="Cloud Functions type-check and local build do not deploy external state.",
)
prefix_rule(
    pattern=["npm", "--prefix", "functions", "test"],
    decision="allow",
    justification="The scoped Cloud Functions test suite is local verification only.",
)
prefix_rule(
    pattern=["npx", "vitest", "run"],
    decision="allow",
    justification="Vitest run is a bounded local verification command.",
)
prefix_rule(
    pattern=["npx", "tsc", "--noEmit"],
    decision="allow",
    justification="TypeScript type-check without emit is verification only.",
)
prefix_rule(
    pattern=["dart", "analyze"],
    decision="allow",
    justification="Static analysis is verification only.",
)
prefix_rule(
    pattern=["flutter", "test"],
    decision="allow",
    justification="Tests are verification only.",
)
prefix_rule(
    pattern=["flutter", "analyze"],
    decision="allow",
    justification="Flutter static analysis is verification only.",
)
prefix_rule(
    pattern=["flutter", "build", "ios"],
    decision="allow",
    justification="An iOS build writes only reproducible local build outputs and does not publish or install.",
)
prefix_rule(
    pattern=["shorebird", "--json", "patches", "list"],
    decision="allow",
    justification="Listing Shorebird patches is read-only release inspection.",
)
prefix_rule(
    pattern=["shorebird", "patches", "list"],
    decision="allow",
    justification="Listing Shorebird patches is read-only release inspection.",
)

# Routine trusted-project workflow commands. Approval and sandbox behavior for
# every command not explicitly allowed here comes from the current Codex task;
# repository rules must not override the user's Normal / Full Access choice.
prefix_rule(
    pattern=["git", ["add", "commit"]],
    justification="Local staging and commits are allowed in this trusted project workflow.",
)
prefix_rule(
    pattern=["dart", "format"],
    justification="Formatting source files is a routine trusted-project workflow step.",
)
prefix_rule(
    pattern=["defaults", "write", "com.apple.iphonesimulator"],
    justification="Simulator keyboard and UI preferences are safe local workflow settings for screenshot capture.",
)
prefix_rule(
    pattern=["xcrun", "simctl"],
    decision="allow",
    justification="Simulator control is allowed in this trusted project workflow.",
    match=[
        "xcrun simctl list devices available",
        "xcrun simctl ui booted appearance light",
    ],
)
