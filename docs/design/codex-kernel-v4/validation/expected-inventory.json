    "drafts/AUDIT-COVERAGE-CLOSURE.csv",
    "drafts/EXPERIMENT-AND-GATE-MATRIX.csv",
    "drafts/K-CAPABILITY-COMPLETION.csv",
    "drafts/P1-IDENTITY-RECEIVE-MATRIX.csv",
    "drafts/P1-OPERATION-STATE-MATRIX.csv",
    "drafts/P2-CAPABILITY-P001-P013.csv",
    "drafts/P2-CAPABILITY-P014-P026.csv",
    "drafts/SOURCE-REUSE-DISPOSITION.csv",
    "validation/README.md",
    "validation/VALIDATION-SPEC.md",
    "validation/expected-inventory.json",
    "validation/validate_design.py"
  ],
  "csv_tables": [
    {
      "path": "matrices/BASELINE-DISPOSITION.csv",
      "id_column": "artifact_id",
      "row_count": 30,
      "min_columns": 10,
      "required_columns": [
        "artifact_id",
        "baseline_path",
        "section_or_contract",
        "disposition",
        "reason",
        "audit_or_requirement_ids",
        "unchanged_invariants",
        "required_delta",
        "verification",
        "status"
      ],
      "id_sequence": [
        {"prefix": "B-", "start": 1, "end": 30, "width": 3}
      ]
    },
    {
      "path": "matrices/USER-DECISION-REQUIRED.csv",
      "id_column": "decision_id",
      "row_count": 9,
      "min_columns": 8,
      "required_columns": [
        "decision_id",
        "question",
        "status",
        "root_recommendation_not_assumed",
        "design_seam_while_unresolved",
        "latest_decision_gate",
        "impact_if_changed",
        "evidence_or_user_basis"
      ],
      "id_sequence": [
        {"prefix": "U-", "start": 1, "end": 9, "width": 3}
      ]
    },
    {
      "path": "drafts/P1-IDENTITY-RECEIVE-MATRIX.csv",
      "id_column": "row_id",
      "row_count": 37,
      "min_columns": 22,
      "required_columns": [
        "row_id",
        "semantic_or_contract",
        "category",
        "baseline_disposition",
        "definition",
        "unique_owner",
        "execution_location",
        "authority_identity",
        "scope_fence",
        "durability",
        "states",
        "typed_errors",
        "capacity_or_bound",
        "unknown_behavior",
        "required_interface",
        "ddl_pressure",
        "wire_pressure",
        "failure_vector",
        "source_locations",
        "evidence_level",
        "change_cost",
        "phase1_status"
      ],
      "id_sequence": [
        {"prefix": "P1-ID-", "start": 1, "end": 9, "width": 3},
        {"prefix": "P1-FN-", "start": 1, "end": 4, "width": 3},
        {"prefix": "P1-RD-", "start": 1, "end": 5, "width": 3},
        {"prefix": "P1-CA-", "start": 1, "end": 6, "width": 3},
        {"prefix": "P1-LV-", "start": 1, "end": 3, "width": 3},
        {"prefix": "P1-WR-", "start": 1, "end": 3, "width": 3},
        {"prefix": "P1-CR-", "start": 1, "end": 2, "width": 3},
        {"prefix": "P1-DEL-", "start": 1, "end": 3, "width": 3},
        {"prefix": "P1-UD-", "start": 6, "end": 7, "width": 3}
      ]
    },
    {
      "path": "drafts/P1-OPERATION-STATE-MATRIX.csv",
      "id_column": "mutation_id",
      "row_count": 38,
      "min_columns": 24,
      "required_columns": [
        "mutation_id",
        "typed_variant",
        "operation_lifecycle_owner",
        "domain_effect_owner",
        "execution_location",
        "target_identity",
        "offline_policy",
        "admission_fingerprint",
        "queue_lane",
        "preconditions",
        "delivery_policy",
        "replay_policy",
        "reconcile_policy",
        "accepted_evidence",
        "canonical_observation",
        "terminal_success",
        "typed_errors",
