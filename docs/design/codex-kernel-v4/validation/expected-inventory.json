      "id_sequence": [
        {"prefix": "P-", "start": 14, "end": 26, "width": 3}
      ]
    },
    {
      "path": "drafts/SOURCE-REUSE-DISPOSITION.csv",
      "id_column": "capability_id",
      "row_count": 52,
      "min_columns": 9,
      "required_columns": [
        "capability_id",
        "current_owner_paths",
        "current_tests",
        "behavior_to_keep",
        "implementation_disposition",
        "forbidden_copy_or_dependency",
        "proposed_seam",
        "fact_level",
        "symbol_call_seam"
      ],
      "id_sequence": [
        {"prefix": "K-", "start": 1, "end": 26, "width": 3},
        {"prefix": "P-", "start": 1, "end": 26, "width": 3}
      ]
    },
    {
      "path": "drafts/AUDIT-COVERAGE-CLOSURE.csv",
