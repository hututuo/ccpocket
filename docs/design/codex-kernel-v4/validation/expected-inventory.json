        "gate_kind",
        "stage_id",
        "scope",
        "required_evidence",
        "positive_acceptance",
        "deliberate_fault_or_negative_vector",
        "pass_rule",
        "fail_action",
        "blocks",
        "status",
        "external_authorization_required"
      ],
      "id_sequence": [
        {"prefix": "H", "start": 0, "end": 18, "width": 2},
        {"prefix": "D", "start": 0, "end": 8, "width": 2}
      ]
    }
  ],
  "source_reference_columns": {
    "drafts/K-CAPABILITY-COMPLETION.csv": ["current_source_paths", "current_tests"],
    "drafts/P1-IDENTITY-RECEIVE-MATRIX.csv": ["source_locations"],
    "drafts/P1-OPERATION-STATE-MATRIX.csv": ["current_source_locations"],
    "drafts/SOURCE-REUSE-DISPOSITION.csv": ["current_owner_paths", "current_tests"]
  },
  "phase2_files": [
    "05-CONTENT-AND-PRODUCT-OPERATIONS.md",
    "drafts/P2-CAPABILITY-P001-P013.csv",
    "drafts/P2-CAPABILITY-P014-P026.csv",
    "drafts/P2-DEVICE-FILES-MEDIA-GIT.md",
    "drafts/P2-NATIVE-PRODUCT-SHELL.md"
  ],
  "final": {
    "required_files": [
      "FULL_DESIGN.md",
      "contracts/contract-registry.json",
      "contracts/sql/negative-vectors.json",
      "matrices/RISK_REGISTER.csv",
      "matrices/EXPERIMENT-AND-GATE-MATRIX.csv",
      "matrices/AUDIT-COVERAGE-CLOSURE.csv"
    ],
    "required_globs": [
      {"pattern": "contracts/schema/*.schema.json", "minimum": 1},
      {"pattern": "contracts/sql/*.sql", "minimum": 2}
    ],
    "contract_registry_required_keys": [
      "formatVersion",
      "status",
      "sourcePartition",
      "budgets",
      "owners",
      "messages",
      "operations",
      "errors",
      "ports",
      "capabilities",
      "schemas",
      "databases",
      "sqlNegativeVectors"
    ],
    "contract_registry_id_arrays": [
      "owners",
      "messages",
      "operations",
      "errors",
      "ports",
      "capabilities",
      "schemas",
      "databases"
    ],
    "negative_vector_required_ids": [
      "cross_source_foreign_key",
      "duplicate_active_claim",
      "duplicate_active_dispatch",
      "outcome_unknown_replay",
      "draft_cascade"
    ]
