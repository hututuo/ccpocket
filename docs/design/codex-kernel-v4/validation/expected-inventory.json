        "phase2_remainder",
        "fact_status"
      ],
      "id_sequence": [
        {"prefix": "OP-", "start": 1, "end": 39, "width": 3, "exclude": [7]}
      ]
    },
    {
      "path": "drafts/K-CAPABILITY-COMPLETION.csv",
      "id_column": "capability_id",
      "row_count": 26,
      "min_columns": 19,
