        "acceptance",
        "rollback",
        "root_coordination_pressure"
      ],
      "id_sequence": [
        {"prefix": "P-", "start": 1, "end": 13, "width": 3}
      ]
    },
    {
      "path": "drafts/P2-CAPABILITY-P014-P026.csv",
      "id_column": "capability_id",
      "row_count": 13,
      "min_columns": 14,
      "required_columns": [
        "capability_id",
        "feature",
