{
  "format_version": 1,
  "design_directory": "docs/design/codex-kernel-v4",
  "control_budgets_bytes": {
    "envelope": 65536,
    "payload": 57344,
    "interaction_answer": 49152
  },
  "preflight_required_files": [
    "00-READ-ME-FIRST.md",
