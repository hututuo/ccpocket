{
  "name": "@ccpocket/bridge",
  "version": "1.69.4-compat.1",
  "description": "Bridge server that connects Claude Agent SDK and Codex CLI sessions to mobile devices via WebSocket",
  "private": false,
  "type": "module",
  "license": "GPL-2.0-only",
  "author": "K9i",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K9i-0/ccpocket.git",
    "directory": "packages/bridge"
  },
  "homepage": "https://github.com/K9i-0/ccpocket/tree/main/packages/bridge#readme",
  "bugs": {
    "url": "https://github.com/K9i-0/ccpocket/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "bridge",
    "websocket",
    "mobile",
    "cli",
    "remote",
    "coding-agent"
  ],
  "bin": {
    "ccpocket-bridge": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "scripts/build-file-browser-helper.mjs",
    "src/file-browser-posix-helper.c",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "env -u CLAUDECODE tsx src/index.ts",
    "build": "tsc && node scripts/build-file-browser-helper.mjs",
    "start": "node dist/index.js",
    "install": "node scripts/build-file-browser-helper.mjs",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:windows-smoke": "vitest run src/path-utils.test.ts src/websocket.test.ts src/codex-process.test.ts",
    "pretest:watch": "npm run build",
    "test:watch": "vitest",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "doctor": "tsx src/cli.ts doctor"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.148",
    "bonjour-service": "^1.3.0",
    "docx-preview": "^0.4.0",
    "jszip": "^3.10.1",
    "marked": "15.0.12",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "socks": "^2.8.7",
    "undici": "^7.24.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
