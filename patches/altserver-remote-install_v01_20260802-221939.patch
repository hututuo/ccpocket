 #pragma mark - Getters -
 
+- (nullable NSArray<ALTDevice *> *)fetchAvailableCoreDevices
+{
+    NSURL *outputURL = [NSFileManager.defaultManager.temporaryDirectory URLByAppendingPathComponent:[NSString stringWithFormat:@"AltServer-CoreDevice-%@.json", NSUUID.UUID.UUIDString]];
+    NSFileHandle *nullDevice = [NSFileHandle fileHandleWithNullDevice];
+
+    NSTask *task = [[NSTask alloc] init];
+    task.executableURL = [NSURL fileURLWithPath:@"/usr/bin/xcrun"];
+    task.arguments = @[
+        @"devicectl", @"list", @"devices",
+        @"--filter", @"State BEGINSWITH 'available' AND Platform == 'iOS' AND connectionProperties.pairingState == 'paired'",
+        @"--timeout", @"5",
+        @"--json-output", outputURL.path,
+        @"--quiet"
+    ];
+    task.standardOutput = nullDevice;
+    task.standardError = nullDevice;
+
+    NSError *launchError = nil;
+    if (![task launchAndReturnError:&launchError])
+    {
+        NSLog(@"CoreDevice enumeration could not start: %@", launchError);
+        return nil;
+    }
+
+    [task waitUntilExit];
+    if (task.terminationStatus != 0)
+    {
+        NSLog(@"CoreDevice enumeration failed with status %d.", task.terminationStatus);
+        [NSFileManager.defaultManager removeItemAtURL:outputURL error:nil];
+        return nil;
+    }
+
+    NSError *readError = nil;
+    NSData *data = [NSData dataWithContentsOfURL:outputURL options:0 error:&readError];
+    [NSFileManager.defaultManager removeItemAtURL:outputURL error:nil];
+    if (data == nil)
+    {
+        NSLog(@"CoreDevice enumeration output could not be read: %@", readError);
+        return nil;
+    }
+
+    NSError *JSONError = nil;
+    NSDictionary *JSON = [NSJSONSerialization JSONObjectWithData:data options:0 error:&JSONError];
+    if (![JSON isKindOfClass:NSDictionary.class])
+    {
+        NSLog(@"CoreDevice enumeration returned invalid JSON: %@", JSONError);
+        return nil;
+    }
+
+    NSDictionary *result = JSON[@"result"];
+    NSArray *devices = result[@"devices"];
+    if (![devices isKindOfClass:NSArray.class])
+    {
+        NSLog(@"CoreDevice enumeration returned no device list.");
+        return nil;
+    }
+
+    NSMutableArray<ALTDevice *> *coreDevices = [NSMutableArray array];
+    for (NSDictionary *deviceDictionary in devices)
+    {
+        if (![deviceDictionary isKindOfClass:NSDictionary.class])
+        {
+            continue;
+        }
+
+        NSDictionary *connectionProperties = deviceDictionary[@"connectionProperties"];
+        NSDictionary *deviceProperties = deviceDictionary[@"deviceProperties"];
+        NSDictionary *hardwareProperties = deviceDictionary[@"hardwareProperties"];
+        if (![connectionProperties isKindOfClass:NSDictionary.class] ||
+            ![deviceProperties isKindOfClass:NSDictionary.class] ||
+            ![hardwareProperties isKindOfClass:NSDictionary.class])
+        {
+            continue;
+        }
+
+        NSString *pairingState = connectionProperties[@"pairingState"];
+        NSString *platform = hardwareProperties[@"platform"];
+        NSString *productType = hardwareProperties[@"productType"];
+        NSString *identifier = hardwareProperties[@"udid"];
+        NSString *name = deviceProperties[@"name"];
+        NSString *version = deviceProperties[@"osVersionNumber"];
+        if (![pairingState isEqualToString:@"paired"] ||
+            ![platform isEqualToString:@"iOS"] ||
+            identifier.length == 0 || name.length == 0)
+        {
+            continue;
+        }
+
+        ALTDeviceType deviceType = ALTDeviceTypeNone;
+        if ([productType hasPrefix:@"iPhone"])
+        {
+            deviceType = ALTDeviceTypeiPhone;
+        }
+        else if ([productType hasPrefix:@"iPad"])
+        {
+            deviceType = ALTDeviceTypeiPad;
+        }
+        else
+        {
+            continue;
+        }
+
+        ALTDevice *device = [[ALTDevice alloc] initWithName:name identifier:identifier type:deviceType];
+        if (version.length > 0)
+        {
+            device.osVersion = NSOperatingSystemVersionFromString(version);
+        }
+        [coreDevices addObject:device];
+    }
+
+    return coreDevices;
+}
